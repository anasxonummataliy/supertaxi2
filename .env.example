# Telegram Bot Token (@BotFather orqali olingan)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Bot adminlarining Telegram ID raqamlari (vergul bilan ajratilgan holda)
ADMIN_IDS=123456789,987654321

# Telegram API ma'lumotlari (https://my.telegram.org dan olinadi)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Webhook sozlamalari
# Masalan: https://domain.uz yoki ngrok URL: https://xxxx.ngrok-free.app
WEBHOOK_BASE_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_secret_token_here

# Server sozlamalari (Uvicorn / FastAPI)
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
DROP_PENDING_UPDATES=true
